<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_order_form_sale" model="ir.ui.view">
        <field name="name">td.workshop.order.form.sale</field>
        <field name="model">td.workshop.order</field>
        <field name="inherit_id" ref="td_workshop.view_workshop_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_start']" position="after">
                <button name="action_create_quotation" type="object" string="Create Quotation"
                        invisible="sale_order_id or state == 'cancel'"/>
            </xpath>
            <field name="technician_id" position="after">
                <field name="sale_order_id"/>
            </field>
        </field>
    </record>
</odoo>
