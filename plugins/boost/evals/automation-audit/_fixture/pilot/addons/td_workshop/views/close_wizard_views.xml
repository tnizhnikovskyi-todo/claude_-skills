<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_close_wizard_form" model="ir.ui.view">
        <field name="name">td.workshop.close.wizard.form</field>
        <field name="model">td.workshop.close.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Close Order" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
