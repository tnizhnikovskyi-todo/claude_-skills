<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_order_list" model="ir.ui.view">
        <field name="name">td.workshop.order.list</field>
        <field name="model">td.workshop.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="device"/>
                <field name="technician_id"/>
                <field name="date_deadline"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_order_form" model="ir.ui.view">
        <field name="name">td.workshop.order.form</field>
        <field name="model">td.workshop.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_close_wizard" type="object" string="Close"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="customer_phone"/>
                            <field name="customer_mobile"/>
                            <field name="device"/>
                            <field name="serial_number"/>
                        </group>
                        <group>
                            <field name="date_received"/>
                            <field name="date_deadline"/>
                            <field name="technician_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parts and Labour" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="discount"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_workshop_order_search" model="ir.ui.view">
        <field name="name">td.workshop.order.search</field>
        <field name="model">td.workshop.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="serial_number"/>
                <filter name="my_orders" string="My Orders" domain="[('technician_id', '=', uid)]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_workshop_order" model="ir.actions.act_window">
        <field name="name">Repair Orders</field>
        <field name="res_model">td.workshop.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
    </record>
</odoo>
