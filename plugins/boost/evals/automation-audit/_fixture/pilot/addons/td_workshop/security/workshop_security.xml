<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_workshop_manager" model="res.groups">
        <field name="name">Workshop Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_workshop_order_company" model="ir.rule">
        <field name="name">Workshop orders: multi-company</field>
        <field name="model_id" ref="model_td_workshop_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_workshop_order_technician" model="ir.rule">
        <field name="name">Workshop orders: technician sees own orders</field>
        <field name="model_id" ref="model_td_workshop_order"/>
        <field name="domain_force">['|', ('technician_id', '=', user.id), ('technician_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_workshop_order_manager" model="ir.rule">
        <field name="name">Workshop orders: manager sees all</field>
        <field name="model_id" ref="model_td_workshop_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_manager'))]"/>
    </record>
</odoo>
