<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_fleet_vehicle_view_list" model="ir.ui.view">
        <field name="name">td.fleet.vehicle.list</field>
        <field name="model">td.fleet.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="driver_id"/>
                <field name="odometer"/>
                <field name="service_count"/>
            </list>
        </field>
    </record>

    <record id="td_fleet_vehicle_view_form" model="ir.ui.view">
        <field name="name">td.fleet.vehicle.form</field>
        <field name="model">td.fleet.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_services" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="service_count" widget="statinfo" string="Services"/>
                        </button>
                    </div>
                    <group>
                        <field name="model_name"/>
                        <field name="license_plate"/>
                        <field name="driver_id"/>
                        <field name="driver_phone"/>
                        <field name="odometer"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="td_fleet_vehicle_action" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">td.fleet.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="td_fleet_menu_root" name="Fleet Lite" action="td_fleet_vehicle_action"/>
</odoo>
