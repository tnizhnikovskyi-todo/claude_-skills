<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_depot_view_form" model="ir.ui.view">
        <field name="name">td.depot.form</field>
        <field name="model">td.depot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="td_code"/>
                        <field name="zone_id"/>
                        <field name="capacity"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="td_depot_view_list" model="ir.ui.view">
        <field name="name">td.depot.list</field>
        <field name="model">td.depot</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="zone_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="td_depot_action" model="ir.actions.act_window">
        <field name="name">Depots</field>
        <field name="res_model">td.depot</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="td_depot_menu" name="Depots" action="td_depot_action"/>
</odoo>
