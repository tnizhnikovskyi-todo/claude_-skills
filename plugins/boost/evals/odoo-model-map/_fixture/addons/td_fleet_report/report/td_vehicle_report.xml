<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_vehicle_report_action" model="ir.actions.report">
        <field name="name">Vehicle sheet</field>
        <field name="model">td.vehicle</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_fleet_report.td_vehicle_report_document</field>
        <field name="binding_model_id" ref="td_fleet.model_td_vehicle"/>
    </record>

    <template id="td_vehicle_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="v">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-field="v.name"/>
                        <p>Plate: <span t-field="v.license_plate"/></p>
                        <p>Mileage: <span t-field="v.odometer"/> km</p>
                        <p>Next service at: <span t-field="v.next_service_km"/> km</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
