<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_fleet_manager" model="res.groups">
        <field name="name">Fleet Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="td_vehicle_company_rule" model="ir.rule">
        <field name="name">Vehicles: own companies</field>
        <field name="model_id" ref="model_td_vehicle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
