<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_vehicle_view_form" model="ir.ui.view">
        <field name="name">td.vehicle.form</field>
        <field name="model">td.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reset_odometer" type="object" string="Reset odometer"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="license_plate"/>
                        <field name="odometer"/>
                        <field name="driver_id"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="td_vehicle_view_list" model="ir.ui.view">
        <field name="name">td.vehicle.list</field>
        <field name="model">td.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="driver_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="td_vehicle_view_search" model="ir.ui.view">
        <field name="name">td.vehicle.search</field>
        <field name="model">td.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="license_plate"/>
                <field name="driver_id"/>
                <filter name="high_mileage" string="High mileage"
                        domain="[('odometer', '&gt;', 100000)]"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="td_vehicle_action" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">td.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="td_fleet_menu_root" name="Fleet"/>
    <menuitem id="td_vehicle_menu" parent="td_fleet_menu_root" action="td_vehicle_action"/>
</odoo>
