<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_vehicle_service_company_rule" model="ir.rule">
        <field name="name">Service log: own companies</field>
        <field name="model_id" ref="model_td_vehicle_service"/>
        <field name="domain_force">[('vehicle_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="td_vehicle_service_own_rule" model="ir.rule">
        <field name="name">Service log: drivers see only their vehicles</field>
        <field name="model_id" ref="model_td_vehicle_service"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('vehicle_id.driver_id.user_ids', 'in', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="td_vehicle_service_manager_rule" model="ir.rule">
        <field name="name">Service log: managers see all</field>
        <field name="model_id" ref="model_td_vehicle_service"/>
        <field name="groups" eval="[(4, ref('td_fleet.group_fleet_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
