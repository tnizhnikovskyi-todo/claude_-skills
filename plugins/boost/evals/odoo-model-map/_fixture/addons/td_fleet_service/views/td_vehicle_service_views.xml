<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_vehicle_service_view_list" model="ir.ui.view">
        <field name="name">td.vehicle.service.list</field>
        <field name="model">td.vehicle.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="odometer_at"/>
                <field name="cost" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_tag_as_repair" type="object" string="To repair"/>
            </list>
        </field>
    </record>

    <record id="td_service_card_view_form" model="ir.ui.view">
        <field name="name">td.service.card.form</field>
        <field name="model">td.service.card</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="card_no"/>
                        <field name="vehicle_id"/>
                        <field name="license_plate"/>
                        <field name="odometer" readonly="1"/>
                        <field name="valid_until"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="td_vehicle_service_action" model="ir.actions.act_window">
        <field name="name">Service log</field>
        <field name="res_model">td.vehicle.service</field>
        <field name="view_mode">list</field>
    </record>

    <record id="td_service_card_action" model="ir.actions.act_window">
        <field name="name">Service cards</field>
        <field name="res_model">td.service.card</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="td_vehicle_service_menu" parent="td_fleet.td_fleet_menu_root"
              action="td_vehicle_service_action"/>
    <menuitem id="td_service_card_menu" parent="td_fleet.td_fleet_menu_root"
              action="td_service_card_action" groups="td_fleet.group_fleet_manager"/>
</odoo>
