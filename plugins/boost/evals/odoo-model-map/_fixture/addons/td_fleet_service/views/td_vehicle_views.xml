<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_vehicle_view_form_service" model="ir.ui.view">
        <field name="name">td.vehicle.form.service</field>
        <field name="model">td.vehicle</field>
        <field name="inherit_id" ref="td_fleet.td_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='odometer']" position="after">
                <field name="next_service_km"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Service" name="service">
                        <field name="service_ids">
                            <list editable="bottom">
                                <field name="date"/>
                                <field name="odometer_at"/>
                                <field name="cost"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
