<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_rental_order_view_list" model="ir.ui.view">
        <field name="name">td.rental.order.list</field>
        <field name="model">td.rental.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'done'">
                <field name="code"/>
                <field name="customer_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="td_rental_order_view_form" model="ir.ui.view">
        <field name="name">td.rental.order.form</field>
        <field name="model">td.rental.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_return" type="object" string="Return"
                            invisible="state != 'ongoing'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="customer_id"/>
                            <field name="customer_phone" widget="phone"/>
                            <field name="customer_mobile" widget="phone"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end" readonly="state == 'done'"/>
                            <field name="daily_rate"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="td_rental_order_action" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">td.rental.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="td_rental_order_view_search" model="ir.ui.view">
        <field name="name">td.rental.order.search</field>
        <field name="model">td.rental.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="customer_id"/>
                <filter name="ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="td_rental_menu_root" name="Rental" groups="group_rental_user"/>
    <menuitem id="td_rental_order_menu" parent="td_rental_menu_root" action="td_rental_order_action"/>
</odoo>
