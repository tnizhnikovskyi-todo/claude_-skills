<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rental" model="ir.module.category">
        <field name="name">Rental</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_rental_user" model="res.groups">
        <field name="name">Rental User</field>
        <field name="category_id" ref="module_category_rental"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rental_manager" model="res.groups">
        <field name="name">Rental Manager</field>
        <field name="category_id" ref="module_category_rental"/>
        <field name="implied_ids" eval="[(4, ref('group_rental_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rental_company" model="ir.rule">
        <field name="name">Rental: multi-company</field>
        <field name="model_id" ref="model_td_rental_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
