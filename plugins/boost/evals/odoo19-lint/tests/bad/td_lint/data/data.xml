<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_recompute" model="ir.cron">
        <field name="name">Recompute</field>
        <field name="model_id" ref="model_td_vehicle"/>
        <field name="state">code</field>
        <field name="code">model._cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
    <record id="uom_pack6" model="uom.uom">
        <field name="name">Pack of 6</field>
        <field name="category_id" ref="uom.product_uom_categ_unit"/>
        <field name="uom_type">bigger</field>
        <field name="factor_inv">6</field>
    </record>
    <record id="product_filters" model="product.template">
        <field name="name">Filters</field>
        <field name="type">product</field>
        <field name="detailed_type">product</field>
    </record>
</odoo>
