{
  "description": "boost/cloud-memory: memory/INDEX.md + HANDOFF.md into context at session start; reminder about uncommitted memory/ at stop",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/memory-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/memory-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
